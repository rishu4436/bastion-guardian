{
  "name": "@bastion-guardian/service-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime for BASTION services: guarded chain clients, loops, health endpoints.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
