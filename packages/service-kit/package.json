  },
  "dependencies": {
    "@bastion-guardian/observability": "workspace:*",
    "viem": "2.40.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
