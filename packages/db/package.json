{
  "name": "@bastion-guardian/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle ORM), migrations and repositories. Amounts are exact integers (numeric(78,0)) with explicit token decimals.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
