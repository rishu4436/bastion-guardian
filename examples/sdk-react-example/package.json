  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.40.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
