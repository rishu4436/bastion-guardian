# BASTION Guardian — environment template. Copy to `.env` (gitignored). NEVER commit real secrets or private keys.
# Phase 0–2: nothing here is required to build or test; all values have safe local defaults.

# --- runtime -----------------------------------------------------------------
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace

# --- API (apps/api) ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_ORIGIN=http://localhost:3000   # CORS allow-origin for the web app
SESSION_SECRET=                      # >= 32 chars; REQUIRED when NODE_ENV=production

# --- data (infrastructure/docker/docker-compose.yml) ----------------------------
POSTGRES_USER=bastion
POSTGRES_PASSWORD=bastion_local_only # local-only default; use a real secret anywhere else
POSTGRES_DB=bastion
DATABASE_URL=postgresql://bastion:bastion_local_only@127.0.0.1:5432/bastion
REDIS_URL=redis://127.0.0.1:6379

# --- chains (public RPCs; see docs/integrations/VERIFIED-ADDRESSES.md) ----------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
REACTIVE_LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
BASE_SEPOLIA_FORK_BLOCK=             # optional: pin fork tests (e.g. 61193053)

# --- safety switches ----------------------------------------------------------
ENABLE_LIVE_EXECUTION=false          # off by default; enabling requires explicit owner authorization
ENABLE_MAINNET=false                 # schema rejects any other value in this phase

# --- deployment (Phase 3 — NOT used yet) ----------------------------------------
# Deployments must use an encrypted Foundry keystore (`cast wallet import`) or a hardware wallet.
# Do NOT place raw private keys in this file.
DEPLOYER_KEYSTORE_ACCOUNT=           # name of a `cast wallet` keystore account
DEPLOYER_ADDRESS=

# --- notifications (Phase 6 — NOT used yet) -------------------------------------
TELEGRAM_BOT_TOKEN=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
WEBHOOK_SIGNING_SECRET=
