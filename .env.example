# BASTION Guardian — environment template. Copy to `.env` (gitignored). NEVER commit real secrets or private keys.
# Nothing here is required to build or test; all values have safe local defaults.

# --- runtime -----------------------------------------------------------------
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace

# --- API (apps/api) ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_ORIGIN=http://localhost:3000   # CORS allow-origin for the web app
SESSION_SECRET=                      # >= 32 chars; REQUIRED when NODE_ENV=production (peppers session/CSRF/code hashes)
SIWE_DOMAIN=localhost:3000           # exact host[:port] of the web app; SIWE messages for other domains are rejected
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                  # forced on when NODE_ENV=production
ADMIN_ADDRESSES=                     # comma-separated operator wallets granted the admin role at sign-in

# --- web (apps/web) -------------------------------------------------------------
BASTION_API_URL=http://localhost:4000   # injected at request time (runtime config)

# --- data (infrastructure/docker/docker-compose.yml) ----------------------------
POSTGRES_USER=bastion
POSTGRES_PASSWORD=bastion_local_only # local-only default; use a real secret anywhere else
POSTGRES_DB=bastion
DATABASE_URL=postgresql://bastion:bastion_local_only@127.0.0.1:5432/bastion
REDIS_URL=redis://127.0.0.1:6379

# --- chains (public RPCs; see docs/integrations/VERIFIED-ADDRESSES.md) ----------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
REACTIVE_LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
BASE_SEPOLIA_FORK_BLOCK=             # optional: pin fork tests (e.g. 61193053)

# --- safety switches ----------------------------------------------------------
ENABLE_LIVE_EXECUTION=false          # off by default; enabling requires explicit owner authorization
ENABLE_MAINNET=false                 # schema rejects any other value in this phase

# --- local simulation services (chain 31337 on 127.0.0.1 only) -------------------
LOCAL_RPC_URL=http://127.0.0.1:8645  # contracts/script/local-e2e.sh --deploy-only starts it
LOCAL_ADDRESSES=contracts/out-evidence/local/addresses.json
INDEXER_START_BLOCK=0
HEALTH_PORT=                         # per-service /healthz port (defaults differ per service)
# Local-only keys for services that send permissionless txs on anvil. Use the PUBLIC anvil dev keys only;
# the write guard refuses any non-local chain unless ENABLE_LIVE_EXECUTION=true.
KEEPER_PRIVATE_KEY=                  # risk-observer: observe()
RETRIER_PRIVATE_KEY=                 # settlement-reconciler: retrySettlement()
SOLVER_PRIVATE_KEY=                  # solver-node reference solver
SOLVER_FEE_BPS=50
SOLVER_MAX_PER_POLICY=
SOLVER_MAX_TOTAL=
SOLVER_MIN_COMMIT=
SOLVER_COMMITMENT_TTL=3600

# --- deployment (Phase 3 — owner-run; NOT used by the agent) -----------------------
# Deployments must use an encrypted Foundry keystore (`cast wallet import`) or a hardware wallet.
# Do NOT place raw private keys in this file.
DEPLOYER_KEYSTORE_ACCOUNT=           # name of a `cast wallet` keystore account
DEPLOYER_ADDRESS=
BASTION_DEPLOY_AUTHORIZED=false      # deploy scripts refuse to broadcast to public networks unless true
BASTION_GUARDIAN=                    # emergency guardian address
DEPLOY_FIXTURE_MARKET=false          # testnet demos only; fixture market is always labeled
REACTIVE_CORE_ADDRESS=               # filled after the Lasna deployment
DEST_CALLBACK_ROUTER=
DEST_RISK_OBSERVER=
DEST_SOLVER_EXECUTOR=
RESERVE_ESCROW=
RESERVE_TOKENS=
ACTIVATE_SUBSCRIPTIONS=false
REACTIVE_CORE_INITIAL_FUNDING_WEI=
CALLBACK_FUNDING_WEI=
OBSERVER_MIN_INTERVAL=
RESERVE_RELEASE_DELAY=
SOLVER_EXIT_DELAY=
SOLVER_MIN_BOND=

# --- notifications (services/notification-dispatcher) -----------------------------
# Missing credentials => that channel is "not configured" and deliveries dead-letter with PROVIDER_NOT_CONFIGURED.
APP_PUBLIC_URL=http://localhost:3000 # deep links in alerts
NOTIFY_CHAIN_ID=31337
VAPID_PUBLIC_KEY=                    # `npx web-push generate-vapid-keys`
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                       # mailto:ops@example.com
TELEGRAM_BOT_TOKEN=
EMAIL_API_KEY=                       # Resend-compatible API
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- tests --------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://bastion:bastion_local_only@127.0.0.1:5432/bastion
TEST_REDIS_URL=redis://127.0.0.1:6379
REQUIRE_INTEGRATION_INFRA=false      # CI sets true so integration suites never silently skip
