    "@bastion-guardian/contracts": "workspace:*",
    "@bastion-guardian/db": "workspace:*",
    "@bastion-guardian/notification-dispatcher": "workspace:*",
    "@bastion-guardian/observability": "workspace:*",
    "@bastion-guardian/risk-engine": "workspace:*",
    "@bastion-guardian/service-kit": "workspace:*",
    "@bastion-guardian/simulator": "workspace:*",
    "@bastion-guardian/solver-coordinator": "workspace:*",
    "@bastion-guardian/types": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.2",
    "@fastify/swagger-ui": "6.1.4",
