    "@bastion-guardian/types": "workspace:*",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.2",
    "fastify": "5.6.2",
    "fastify-type-provider-zod": "6.1.0",
    "openapi-types": "12.1.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
