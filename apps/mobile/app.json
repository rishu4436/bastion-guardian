{
  "expo": {
    "name": "BASTION Guardian",
    "slug": "bastion-guardian",
    "scheme": "bastion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1220",
    "ios": { "supportsTablet": true, "bundleIdentifier": "dev.bastion.guardian" },
    "android": {
      "package": "dev.bastion.guardian",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0b1220" }
    },
    "extra": { "defaultApiUrl": "http://localhost:4000", "defaultWebUrl": "http://localhost:3000" }
  }
}
