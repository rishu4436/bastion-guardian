{
  "name": "@bastion/local-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "LOCAL SIMULATION: a Reactive-Network-style relay for anvil (impersonates the system contract, delivers callbacks through the local callback proxy) and the end-to-end rescue scenario.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "scenario": "tsx src/scenario.ts"
  },
  "dependencies": {
    "@bastion-guardian/contracts": "workspace:*",
    "@bastion-guardian/risk-engine": "workspace:*",
    "viem": "2.40.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
